{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp|pdf|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/adb2.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/adb2b", "dest": "/api/adb2.php" },
    { "src": "/bidpause", "dest": "/bidpause.html" },
    { "src": "/test", "dest": "/test.html" },
    { "src": "/adb", "dest": "/adb.html" },
    { "src": "/adb_cp", "dest": "/adb_cp.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}