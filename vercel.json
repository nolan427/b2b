{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "*.{css,js,png,jpg,jpeg,gif,svg,ico,pdf,txt,json,woff,woff2}", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "^/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|pdf|txt|json|woff2?))$",
      "dest": "/$1"
    },
    {
      "src": "^/(?!.*\\..*)(.*)$",
      "dest": "/index.html"
    }
  ]
}
