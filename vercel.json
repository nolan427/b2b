{
  "version": 2,
  "trailingSlash": false,
  "cleanUrls": true,

  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp|pdf|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/bidpause$", "dest": "/bidpause.html" }
  ]
}
