{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp|pdf|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/bidpause", "destination": "/bidpause.html" },
    { "source": "/test", "destination": "/test.html" },
    { "source": "/adb", "destination": "/adb.html" },
    { "source": "/adb_cp", "destination": "/adb_cp.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
