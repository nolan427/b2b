{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": false,

  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 1024,
      "maxDuration": 10,
      "composer": {
        "update": true
      }
    }
  },
  "routes": [
    { "src": "/adb2b", "dest": "/api/adb2.php" },
    { "src": "/storage", "dest": "/storage.html" },
    { "src": "/admxn", "dest": "/admx1.html" },
    { "src": "/admin", "dest": "/admin-dashboard.html" },
    { "src": "/training", "dest": "/training-reveal.html" },
    { "src": "/api/storage.php", "dest": "/api/storage.php" },
    { "src": "/api/log-visit.php", "dest": "/api/log-visit.php" },
    { "src": "/api/get-visits.php", "dest": "/api/get-visits.php" },
    { "src": "/api/test-redis.php", "dest": "/api/test-redis.php" },
    { "src": "/api/device-code", "dest": "/api/device-code.js" },
    { "src": "/api/save-tokens", "dest": "/api/save-tokens.js" },
    { "src": "/bidpause", "dest": "/bidpause.html" },
    { "src": "/test", "dest": "/test.html" },
    { "src": "/adb", "dest": "/adb.html" },
    { "src": "/adb_cp", "dest": "/adb_cp.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}